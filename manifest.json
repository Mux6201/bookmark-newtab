{
  "manifest_version": 3,
  "name": "书签台 · 新标签页",
  "version": "1.1.0",
  "description": "把浏览器书签整理成抽屉卡片,替换新标签页,支持检索与导入书签 HTML。",
  "permissions": ["bookmarks", "favicon", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
